# ── Chain mode ──────────────────────────────────────────────
# "simulated" (default): an in-process replica of the escrow program. No wallet or SOL needed.
# "devnet" / "localnet": real transactions against the deployed payoo_escrow program.
PAYOO_CHAIN_MODE=simulated

# RPC endpoint for devnet/localnet modes
SOLANA_RPC_URL=https://api.devnet.solana.com

# Program id (matches declare_id! / Anchor.toml)
PAYOO_PROGRAM_ID=JDyePwDypafn8Yi9fZdzPYp7b4uztLKD9zZ3DfV4VxVy

# Keys + mint written by `npm run devnet:setup` (default: .data/chain-keys.json)
# PAYOO_KEYS_FILE=.data/chain-keys.json

# ── FX rates ────────────────────────────────────────────────
# Optional Pyth Hermes endpoint (Hermes now needs an API key; include it in the URL if your provider uses one)
# PYTH_HERMES_URL=https://hermes.pyth.network
# Pyth FX.USD/CNH feed
PYTH_USDCNH_FEED_ID=eef52e09c878ad41f6a81803e3640fe04dceea727de894edd4ea117e2e332e66
